{
  "manifest_version": 3,
  "name": "StumbleChat Accessible",
  "version": "1.2.0",
  "description": "Restyles stumblechat.com with a clean light or dark theme, WCAG 2.2 AA accessibility fixes, and layouts that work on phones and in crowded rooms.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "StumbleChat Accessible",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://stumblechat.com/*",
        "*://*.stumblechat.com/*"
      ],
      "css": [
        "styles/theme.css",
        "styles/room-features.css",
        "styles/chat-features.css",
        "styles/directory-tools.css"
      ],
      "js": [
        "scripts/content.js",
        "scripts/room-features.js",
        "scripts/chat-features.js",
        "scripts/directory-tools.js",
        "scripts/quick-settings.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*"
      ],
      "matches": [
        "*://stumblechat.com/*",
        "*://*.stumblechat.com/*"
      ]
    }
  ]
}
